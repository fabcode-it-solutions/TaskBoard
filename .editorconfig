root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_style = space
indent_size = 4

[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

# ==== Frontend ======
[*.html]
indent_style = space
indent_size = 4

[*.css]
indent_style = space
indent_size = 4

[*.scss]
indent_style = space
indent_size = 4

[*.ts]
indent_style = space
indent_size = 4
quote_type = single
ij_typescript_use_double_quotes = false

[*.js]
indent_style = space
indent_size = 4

# ==== Backend ======
[*.java]
indent_style = space
indent_size = 4

[*.yml,*.yaml]
indent_style = space
indent_size = 4

[*.properties]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 4

