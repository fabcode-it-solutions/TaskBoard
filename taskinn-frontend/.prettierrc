{
    "tabWidth": 4,
    "useTabs": false,
    "bracketSameLine": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 120,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular",
          "htmlWhitespaceSensitivity": "strict",
          "printWidth": 240
        }
      }
    ]
  }
