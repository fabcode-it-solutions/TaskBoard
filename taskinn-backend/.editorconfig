root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_style = space
indent_size = 4

[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

# ==== Backend ======
[*.java]
indent_style = space
indent_size = 4

[*.yml,*.yaml]
indent_style = space
indent_size = 4

[*.properties]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 4

